rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== FUNCIONES AUXILIARES =====
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.rol == 1; // ADMINISTRADOR
    }

    // Validar que el usuario pertenezca a una sucursal válida
    function hasValidSucursal() {
      return isSignedIn() && 
             userDoc().data.sucursal != null &&
             userDoc().data.sucursal != '';
    }

    // Validar que el usuario esté activo (autorizado)
    function isActive() {
      return isSignedIn() && userDoc().data.activo == true;
    }

    // Operador autorizado: sucursal válida + activo
    function isAuthorizedOperator() {
      return hasValidSucursal() && isActive();
    }

    // Verificar si el usuario pertenece a una sucursal específica
    function belongsToSucursal(sucursal) {
      return isSignedIn() && userDoc().data.sucursal == sucursal;
    }

    // Usuario puede leer métricas: cualquier usuario autenticado
    function canReadMetrics() {
      return isSignedIn();
    }

    // ===== USUARIOS =====
    match /usuarios/{uid} {
      // Leer: el propio documento, usuarios de sucursales válidas, admin, o durante registro
      allow read: if (isSignedIn() && request.auth.uid == uid) || hasValidSucursal() || isAdmin() || true;
      
      // Crear su propio documento durante registro (usuario recién creado en Auth)
      allow create: if isSignedIn() && request.auth.uid == uid;
      
      // Actualizar/Eliminar: el propio usuario o un administrador
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ===== MÁQUINAS AUTORIZADAS =====
    match /maquinas_autorizadas/{maquinaId} {
      // Leer: cualquier usuario autenticado (para verificación de acceso en Electron)
      allow read: if isSignedIn();
      
      // Crear/Actualizar/Eliminar: solo administradores
      allow create, update, delete: if isAdmin();
    }
    // ===== SUCURSALES =====
    match /sucursales/{sucursalId} {
      // Leer: cualquier usuario autenticado (para selección de sucursales)
      allow read: if isSignedIn();
      
      // Crear/Actualizar/Eliminar: solo administradores
      allow create, update, delete: if isAdmin();
    }

    // ===== CLIENTES =====
    match /clientes/{clienteId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
      
      // Subcolección: Historial Clínico
      match /historialClinico/{documento} {
        allow read, write: if isAdmin() || isAuthorizedOperator();
      }
    }

    // ===== PRODUCTOS =====
    match /productos/{productoId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== PROVEEDORES =====
    match /proveedores/{proveedorId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== INGRESOS =====
    match /ingresos/{ingresoId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
      
      // Subcolección: Detalles del Ingreso
      match /detalles/{detalleId} {
        allow read, write: if isAdmin() || isAuthorizedOperator();
      }
    }

    // ===== FACTURAS =====
    match /facturas/{facturaId} {
      // Leer: cualquier usuario autenticado (para métricas y reportes)
      allow read: if isSignedIn();
      // Escribir: admin o operador autorizado
      allow write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== FACTURAS_DEUDAS =====
    match /facturas_deudas/{deudaId} {
      // Leer: cualquier usuario autenticado (para métricas y reportes)
      allow read: if isSignedIn();
      // Escribir: admin o operador autorizado
      allow write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== VENTAS TARJETA =====
    match /ventas_tarjeta/{ventaId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== MOVIMIENTOS DE STOCK =====
    match /movimientos_stock/{movId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== CAJAS BANCO =====
    match /cajas_banco/{cajaId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== MOVIMIENTOS CAJAS BANCO =====
    match /movimientos_cajas_banco/{movId} {
      // Leer: cualquier usuario autenticado (para métricas de pagos)
      allow read: if isSignedIn();
      // Escribir: admin o operador autorizado
      allow write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== CAJAS CHICAS =====
    match /cajas_chicas/{cajaId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== MOVIMIENTOS CAJAS CHICAS =====
    match /movimientos_cajas_chicas/{movId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== CUENTAS (POR PAGAR Y COBRAR) =====
    match /cuentas/{cuentaId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== COUNTERS / AUXILIARES =====
    match /counters/{counterId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== EGRESOS DE MERCADERÍA =====
    match /egresosMercaderia/{egresoId} {
      allow read, write: if isAdmin() || isAuthorizedOperator();
    }

    // ===== DENEGAR TODO LO DEMÁS POR DEFECTO =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
