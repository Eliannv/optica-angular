.facturas-container{max-width:1400px;margin:0 auto;padding:1rem;}.facturas-card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-lg);}.facturas-header{padding:1.25rem 1.5rem;border-bottom:1px solid var(--border-color);background:var(--bg-secondary);}.header-content{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;}.facturas-title{margin:0;font-size:1.35rem;font-weight:600;color:var(--text-primary);}.btn-primary{padding:0.65rem 1.25rem;border-radius:var(--radius-md);font-weight:600;font-size:0.9rem;border:none;cursor:pointer;transition:all var(--transition-fast);background:var(--btn-primary-bg);color:var(--btn-primary-text);white-space:nowrap;}.btn-primary:hover{transform:translateY(-2px);background:var(--btn-primary-hover);box-shadow:var(--shadow-md);}.filtros-container{padding:1rem 1.5rem;background:var(--bg-secondary);border-bottom:1px solid var(--border-color);display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;}.filtro-item{display:flex;align-items:center;gap:0.75rem;}.filtro-item label{display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;font-weight:600;color:var(--text-primary);margin:0;white-space:nowrap;}.filtro-item label svg{color:var(--primary-color);flex-shrink:0;}.filtro-item select,.filtro-item input[type="date"]{min-width:180px;height:36px;padding:0.4rem 0.75rem;border:1px solid var(--border-color);border-radius:var(--radius-md);background:var(--bg-card);color:var(--text-primary);font-size:0.9rem;}.filtro-item select:disabled,.filtro-item input[type="date"]:disabled{opacity:0.6;cursor:not-allowed;background:var(--bg-tertiary);}.fecha-input-group{position:relative;display:flex;align-items:center;}.fecha-input-group input[type="date"]::-webkit-calendar-picker-indicator{cursor:pointer;}.fecha-input-group input[type="date"].has-value::-webkit-calendar-picker-indicator{display:none;}.btn-clear-fecha{position:absolute;right:8px;background:var(--bg-tertiary);border:none;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0.7;transition:all 0.2s;padding:0;overflow:hidden;line-height:1;}.btn-clear-fecha:hover{opacity:1;background:var(--danger-color);color:white;}.btn-clear-fecha svg{stroke:currentColor;display:block;flex-shrink:0;}.search-input-group{position:relative;display:flex;align-items:center;}.search-input-group input.form-control{min-width:280px;height:36px;padding:0.4rem 2rem 0.4rem 0.75rem;border:1px solid var(--border-color);border-radius:var(--radius-md);background:var(--bg-card);color:var(--text-primary);font-size:0.9rem;}.search-input-group input.form-control::placeholder{color:var(--input-placeholder);}.btn-clear-busqueda{position:absolute;right:8px;background:var(--bg-tertiary);border:none;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0.7;transition:all 0.2s;padding:0;overflow:hidden;line-height:1;}.btn-clear-busqueda:hover{opacity:1;background:var(--danger-color);color:white;}.btn-clear-busqueda svg{stroke:currentColor;display:block;flex-shrink:0;}.facturas-body{padding:1.5rem;}.table-wrapper{overflow-x:auto;border-radius:var(--radius-lg);border:1px solid var(--border-color);}.facturas-table{width:100%;border-collapse:collapse;font-size:0.9rem;}.facturas-table thead{background:var(--table-header-bg);}.facturas-table th{padding:1rem;text-align:left;font-weight:600;font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-primary);opacity:0.9;border-bottom:2px solid var(--border-color);}.facturas-table tbody tr{border-bottom:1px solid var(--border-light);transition:all var(--transition-fast);}.facturas-table tbody tr:hover{background:var(--table-row-hover);}.facturas-table td{padding:1rem;color:var(--text-primary);}.col-id{width:150px;}.col-cliente{min-width:200px;}.col-pago{width:150px;}.col-total{width:120px;}.col-acciones{width:100px;text-align:center;}.badge-id{display:inline-block;padding:0.35rem 0.75rem;border-radius:var(--radius-md);font-weight:600;font-size:0.8rem;background:var(--primary-color);color:var(--text-inverse);}.badge-pago{display:inline-block;padding:0.35rem 0.75rem;border-radius:var(--radius-md);font-weight:600;font-size:0.8rem;background:rgba(46,204,113,0.15);color:#2ecc71;border:1px solid rgba(46,204,113,0.25);}.badge{display:inline-block;padding:0.35rem 0.75rem;border-radius:var(--radius-md);font-weight:600;font-size:0.8rem;border:1px solid transparent;}.badge-success{background:rgba(46,204,113,0.15);color:#2ecc71;border-color:rgba(46,204,113,0.25);}.badge-danger{background:rgba(224,129,13,0.15);color:rgb(224,129,13);border-color:rgba(224,129,13,0.25);}.precio{font-weight:700;font-size:1.05rem;color:var(--primary-color);}.action-buttons{display:flex;gap:0.5rem;align-items:center;justify-content:center;flex-wrap:nowrap;}.btn-action{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;border:none;cursor:pointer;transition:all var(--transition-fast);padding:0;flex-shrink:0;}.btn-action svg{width:20px;height:20px;stroke-width:2;}.btn-action-view{color:#fff;background:#3b82f6;}.btn-action-view:hover{background:#2563eb;transform:translateY(-2px);box-shadow:0 4px 12px rgba(59,130,246,0.25);}.btn-action-warning{color:#fff !important;background:#6c757d !important;}.btn-action-warning:hover{background:#5a6268 !important;transform:translateY(-2px);box-shadow:0 4px 12px rgba(108,117,125,0.25);}.btn-action-danger{color:#fff;background:#ef4444;}.btn-action-danger:hover{background:#dc2626;transform:translateY(-2px);box-shadow:0 4px 12px rgba(239,68,68,0.25);}.btn-action-payment{color:#fff;background:#f59e0b;}.btn-action-payment:hover{background:#d97706;transform:translateY(-2px);box-shadow:0 4px 12px rgba(245,158,11,0.35);}.btn-action-payment:disabled,.btn-action-payment[disabled]{background:rgba(245,158,11,0.35);color:rgba(255,255,255,0.75);cursor:not-allowed;transform:none;box-shadow:none;opacity:0.75;}.btn-ver{padding:0.5rem 1rem;border-radius:var(--radius-md);border:1px solid var(--border-color);background:var(--btn-secondary-bg);color:var(--btn-secondary-text);cursor:pointer;font-weight:600;font-size:0.85rem;transition:all var(--transition-fast);}.btn-ver:hover{background:var(--btn-primary-bg);border-color:var(--btn-primary-bg);color:var(--btn-primary-text);transform:translateY(-1px);}.mobile-cards{display:flex;flex-direction:column;gap:1rem;}.factura-card-mobile{padding:1rem;border-radius:var(--radius-lg);border:1px solid var(--border-color);background:var(--bg-secondary);cursor:pointer;transition:all var(--transition-fast);}.factura-card-mobile:hover{background:var(--bg-hover);border-color:var(--primary-color);transform:translateY(-2px);box-shadow:var(--shadow-md);}.card-mobile-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;padding-bottom:0.75rem;border-bottom:1px solid var(--border-light);}.card-mobile-body{display:flex;flex-direction:column;gap:0.5rem;margin-bottom:0.75rem;}.cliente-mobile,.total-mobile{display:flex;flex-direction:column;gap:0.25rem;}.label{font-size:0.75rem;opacity:0.7;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);}.card-mobile-footer{display:flex;justify-content:flex-end;}.mobile-action-buttons{display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;justify-content:flex-end;}.btn-action{display:inline-flex;align-items:center;justify-content:center;gap:0.4rem;padding:0.45rem 1rem;border-radius:10px;border:none;cursor:pointer;transition:all var(--transition-fast);font-size:0.85rem;font-weight:500;}.btn-action svg{width:18px;height:18px;flex-shrink:0;stroke-width:2;}.btn-action-view{color:#3b82f6;background:#dbeafe;}.btn-action-view:hover{background:#bfdbfe;transform:translateY(-1px);box-shadow:0 4px 12px rgba(59,130,246,0.25);}.btn-action-payment-mobile{display:inline-flex;align-items:center;gap:0.4rem;padding:0.45rem 1rem;border-radius:10px;border:none;background:rgba(245,158,11,0.18);color:#f59e0b;cursor:pointer;font-weight:500;font-size:0.85rem;transition:all var(--transition-fast);flex-shrink:0;}.btn-action-payment-mobile:hover{background:rgba(245,158,11,0.28);transform:translateY(-1px);box-shadow:0 4px 12px rgba(245,158,11,0.35);}.btn-action-payment-mobile:disabled,.btn-action-payment-mobile[disabled]{background:rgba(245,158,11,0.1);color:rgba(245,158,11,0.6);cursor:not-allowed;transform:none;box-shadow:none;opacity:0.75;}.btn-action-payment-mobile svg{width:16px;height:16px;flex-shrink:0;stroke-width:2;}.btn-ver-mobile{padding:0.5rem 1rem;border-radius:var(--radius-md);border:1px solid var(--border-color);background:var(--btn-secondary-bg);color:var(--btn-secondary-text);cursor:pointer;font-weight:600;font-size:0.85rem;transition:all var(--transition-fast);}.btn-ver-mobile:hover{background:var(--btn-primary-bg);border-color:var(--btn-primary-bg);color:var(--btn-primary-text);transform:translateY(-1px);}.empty-state{text-align:center;padding:4rem 2rem;}.empty-icon{font-size:4rem;margin-bottom:1rem;opacity:0.3;}.empty-state p{font-size:1.1rem;font-weight:600;margin:0.5rem 0;color:var(--text-primary);}.empty-state span{font-size:0.9rem;opacity:0.7;color:var(--text-secondary);}.pagination-controls{display:flex;justify-content:space-between;align-items:center;padding:1rem 0;margin-top:1rem;border-top:1px solid var(--border-color);}.pagination-info{font-size:0.9rem;}.pagination-info .text-muted{opacity:0.7;color:var(--text-secondary);}.pagination-buttons{display:flex;gap:0.75rem;}.btn-pagination{padding:0.6rem 1.25rem;border-radius:var(--radius-md);border:1px solid var(--border-color);background:var(--btn-secondary-bg);color:var(--btn-secondary-text);cursor:pointer;font-weight:600;font-size:0.85rem;transition:all var(--transition-fast);}.btn-pagination:hover:not(:disabled){background:var(--btn-primary-bg);border-color:var(--btn-primary-bg);color:var(--btn-primary-text);transform:translateY(-1px);}.btn-pagination:disabled{opacity:0.4;cursor:not-allowed;}.desktop-only{display:block;}.mobile-only{display:none;}@media (max-width:768px){.desktop-only{display:none;}.mobile-only{display:block;}.header-content{flex-direction:column;align-items:stretch;}.btn-primary{width:100%;}}@media (max-width:480px){.facturas-container{padding:0.75rem;}.facturas-header{padding:1rem;}.facturas-title{font-size:1.15rem;}.facturas-body{padding:1rem;}.search-input{padding:0.75rem 2.5rem;font-size:0.85rem;}.factura-card-mobile{padding:0.85rem;}.badge-id,.badge-pago{font-size:0.75rem;padding:0.3rem 0.6rem;}.pagination-controls{flex-direction:column;gap:1rem;}.pagination-buttons{width:100%;}.btn-pagination{flex:1;}}@media (max-width:360px){.facturas-container{padding:0.5rem;}.facturas-header,.facturas-body{padding:0.85rem;}.facturas-title{font-size:1.05rem;}.btn-primary{padding:0.6rem 1rem;font-size:0.85rem;}}